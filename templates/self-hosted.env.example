# DecisionAtlas self-hosted environment template
# Copy this file to .env on the operator-controlled host.
# Never commit real secrets, provider keys, repository tokens, or private URLs.

# Core service URLs
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/decisionatlas
REDIS_URL=redis://127.0.0.1:6379/0
ENGINE_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:3001

# Local/bootstrap auth for first-admin recovery in self-hosted evaluation.
# Disable or replace with a deployment-specific auth boundary before wider exposure.
AUTO_BOOTSTRAP_AUTH=true

# Optional live model provider configuration.
# Keep these values on backend/server-side surfaces only.
LLM_PROVIDER_MODE=fake
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional repository access.
# Prefer owner-scoped product setup flows for repository credentials.
GITHUB_TOKEN=
DEMO_REPO=

# Public/private URL overrides for operator documentation.
DECISIONATLAS_PUBLIC_WEB_URL=http://127.0.0.1:3000
DECISIONATLAS_PUBLIC_API_URL=http://127.0.0.1:3001
DECISIONATLAS_ENGINE_URL=http://127.0.0.1:8000
