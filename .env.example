DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/decisionatlas
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER_MODE=auto
EMBEDDING_PROVIDER_MODE=auto
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
GITHUB_TOKEN=
GITHUB_IMPORT_MAX_PAGES=5
# Keep disabled until Issue #36 worker/SQLite pause-resume safety is validated.
IMPORT_PAUSE_RESUME_ENABLED=false
DEMO_WORKSPACE_SLUG=demo-workspace
DEMO_REPO=encode/httpx
# Local development defaults. For hosted/self-hosted production, set APP_ENV=production (or NODE_ENV=production),
# provide ENGINE_BASE_URL explicitly, keep AUTO_BOOTSTRAP_AUTH=false, and allowlist
# the exact public Web origin(s) in CORS_ALLOWED_ORIGINS.
APP_ENV=development
AUTO_BOOTSTRAP_AUTH=false
ENGINE_BASE_URL=http://localhost:8000
# Next.js server-only upstream address. Browser requests use same-origin /backend/*
# and never connect to 127.0.0.1:3001 on the visitor's machine.
API_BASE_URL=http://localhost:3001
# Match the Fastify BFF cookie name; only this cookie is SSR-forwarded.
AUTH_COOKIE_NAME=decisionatlas_session
# Production: Fastify still checks Origin on state-changing proxied requests;
# allowlist the actual public Web origin in CORS_ALLOWED_ORIGINS, not '*'.
# CORS_ALLOWED_ORIGINS=https://your-decisionatlas-domain.example
